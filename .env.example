# =====================================================
# ScanGo — Environment Variables
# Copy to .env and update values for your environment
# =====================================================

# ── General ─────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── API Gateway ─────────────────────────────────────
API_GATEWAY_PORT=3000
BACKEND_HOST=localhost

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scango
POSTGRES_PASSWORD=scango_dev_pass

# ── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=        # No password in dev

# ── MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://scango:scango_dev_pass@localhost:27017/scango_catalog?authSource=admin

# ── Kafka ───────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── OpenSearch ──────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── MinIO (S3-compatible) ───────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=scango_minio
MINIO_SECRET_KEY=scango_minio_pass
MINIO_USE_SSL=false
MINIO_BUCKET_EVIDENCE=scango-evidence
MINIO_BUCKET_RECEIPTS=scango-receipts

# ── JWT / Auth ──────────────────────────────────────
JWT_SECRET=scango-dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Payment Gateway (Stripe Test) ───────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── External Service Stubs ──────────────────────────
# ERP_API_URL=http://localhost:8080/erp
# CRM_API_URL=http://localhost:8080/crm
# TAX_ENGINE_URL=http://localhost:8080/tax
# SMS_GATEWAY_API_KEY=
# PUSH_NOTIFICATION_KEY=

# ── Firebase ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
