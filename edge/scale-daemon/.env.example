# Serial port for the scale ('COM3' on Windows, '/dev/ttyUSB0' on Linux)
SCALE_SERIAL_PORT=/dev/ttyUSB0

# Serial baud rate
BAUD_RATE=9600

# Required identifiers
STORE_ID=store_001
LANE_CODE=lane_1

# MQTT Configuration
MQTT_BROKER_URL=mqtt://localhost:1883

# Debounce interval in ms for publishing to MQTT
DEBOUNCE_INTERVAL_MS=500
